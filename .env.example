# Copy to .env (never commit .env) or set these in your shell / cloud environment.

# Free key from https://aistudio.google.com -> "Get API key". Optional: without it the system uses
# TF-IDF search and template answers.
GEMINI_API_KEY=

# Required by the SEC for downloads: a name and a contact email.
SEC_USER_AGENT="PES Capstone PW26_DG_01 your-email@example.edu"

# Optional overrides
# FININTEL_DATA_DIR=data
# FININTEL_LLM_MODEL=gemini-3.6-flash  (run `python -m finintel check-llm` to see which models work)
# FININTEL_EMBED_MODEL=gemini-embedding-001
